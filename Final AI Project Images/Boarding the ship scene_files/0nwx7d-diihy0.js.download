NSUhEUgAAAAYAAAAICAIAAABVpBlvAAAAo0lEQVR42gGYAGf/AMTEprGuk4SDU11cM1tXMmJcOwCUmGGIiVmIe1uKdl9sZDhRTSQAmJxiaGtAmnxkjm5YhXdHeHdCAJCVX3p0SoRmTIFfQW1fO2NuQgCcll6Ti1lZRSyDaUWKeVSKh1QAanNCg4NRgm1Sf25IeGpEdXRHAG5/SpOQaJuOcVxQLlJIJlpZNgBTZDGDbFNsXkE/NxpCOh1aWzZcjDoCwI4sFwAAAABJRU5ErkJggg=="};e.s(["APPLY_STYLES_CAROUSEL",0,[{id:"realistic",labelKey:"style_realistic",promptKey:"style_prompt_realistic",image:y,promptText:"Transform my uploaded photo into a hyper-realistic, high-definition image. Enhance the lighting, textures, and details to make it look like a professionally shot photograph with perfect clarity, natural colors, and cinematic depth of field."},{id:"cartoon",labelKey:"style_cartoon",promptKey:"style_prompt_cartoon",image:A,promptText:"Transform my uploaded photo into a vibrant cartoon illustration. Reimagine the subject with bold outlines, exaggerated features, bright saturated colors, and a fun animated style similar to modern animated movies."},{id:"3d",labelKey:"style_3d",promptKey:"style_prompt_3d",image:g,promptText:"Transform my uploaded photo into a high-quality 3D render. Reimagine the subject as a detailed 3D model with smooth surfaces, studio lighting, subtle shadows, and a polished three-dimensional appearance like a Pixar or CGI character."},{id:"anime",labelKey:"style_anime",promptKey:"style_prompt_anime",image:m,promptText:"Transform my uploaded photo into anime art style. Reimagine the subject with large expressive eyes, stylized hair, clean line art, and the distinctive aesthetic of Japanese anime with dramatic lighting and vivid colors."},{id:"digital-art",labelKey:"style_digital_art",promptKey:"style_prompt_digital_art",image:f,promptText:"Transform my uploaded photo into a stunning piece of digital art. Reimagine the subject with creative digital painting techniques, rich color palettes, artistic brushstrokes, and a modern digital illustration aesthetic."},{id:"abstract",labelKey:"style_abstract",promptKey:"style_prompt_abstract",image:h,promptText:"Transform my uploaded photo into an abstract artwork. Reimagine the subject using geometric shapes, bold color blocks, surreal compositions, and artistic abstraction while keeping the essence of the original recognizable."}],"DISCOVER_PROMPTS",0,[{id:"cartoon_character",labelKey:"discover_prompt_cartoon",promptKey:"discover_prompt_text_cartoon",image:r,promptText:"Take my uploaded photo and transform me into a fun cartoon character. Reimagine my appearance as if I were a character in a Pixar or Disney animated movie — use bold outlines, exaggerated but flattering features, vibrant colors, and an expressive animated style. Keep my likeness recognizable."},{id:"headshot",labelKey:"discover_prompt_headshot",promptKey:"discover_prompt_text_headshot",image:i,promptText:"Take my uploaded photo and create a professional business headshot. Enhance the lighting, sharpen the details, use a clean neutral or gradient background, ensure professional attire and posture, and make me look polished and confident — as if shot by a professional portrait photographer."},{id:"pet_royalty",labelKey:"discover_prompt_pet_royalty",promptKey:"discover_prompt_text_pet_royalty",image:a,promptText:"Take my uploaded photo and reimagine my pet as royalty. Dress them in regal attire like a crown, royal cape, and jewels. Place them on an ornate throne or in a grand palace setting. Make it look like an official royal portrait painting with dramatic lighting and rich, opulent details."},{id:"superhero",labelKey:"discover_prompt_superhero",promptKey:"discover_prompt_text_superhero",image:l,promptText:"Take my uploaded photo and transform me into a superhero. Give me a unique, original superhero costume with a cape, mask or emblem, and superhero-like physique. Place me in a dramatic action pose with a cityscape or epic background. Add visual effects like energy auras, wind, or dramatic lighting."},{id:"watercolor",labelKey:"discover_prompt_watercolor",promptKey:"discover_prompt_text_watercolor",image:n,promptText:"Take my uploaded photo and transform it into a beautiful watercolor painting. Use soft, flowing watercolor brushstrokes, gentle color bleeds, translucent washes, and the characteristic paper texture of traditional watercolor art. Keep the composition recognizable but with an artistic, hand-painted quality."},{id:"action_figure",labelKey:"discover_prompt_action_figure",promptKey:"discover_prompt_text_action_figure",image:t,promptText:"Take my uploaded photo and reimagine me as a collectible action figure displayed in its packaging. Show me as a detailed action figure with a plastic-like texture, articulated joints, and accessories. Include realistic toy packaging with a clear window, colorful backing card, and product branding."}],"IDEAS_CHIPS",0,[{id:"enhance",labelKey:"ideas_chip_enhance",prompts:[{id:"restore-photo",labelKey:"ideas_prompt_restore_photo",promptText:"Restore this old photo. Bring back the original colors, sharpen the details, and keep the faces exactly the same.",requiresUpload:!0},{id:"professional-headshot",labelKey:"ideas_prompt_professional_headshot",promptText:"Turn this into a professional headshot. Soft studio lighting, sharp focus on the eyes, neutral background. Keep my face exactly the same.",requiresUpload:!0},{id:"oil-painting",labelKey:"ideas_prompt_oil_painting",promptText:"Turn this photo into an oil painting portrait with visible brushstrokes and rich color. Keep the person recognizable.",requiresUpload:!0},{id:"colorize-photo",labelKey:"ideas_prompt_colorize_photo",promptText:"Colorize this black-and-white photo. Use natural, realistic colors. Keep all the original details intact.",requiresUpload:!0}]},{id:"create-art",labelKey:"ideas_chip_create_art",prompts:[{id:"cartoonize",labelKey:"ideas_prompt_cartoonize",promptText:"Turn this photo into a fun cartoon illustration. Keep the people recognizable, but make it colorful and stylized.",requiresUpload:!0},{id:"watercolor-painting",labelKey:"ideas_prompt_watercolor_painting",promptText:"Turn this into a watercolor painting with soft edges and flowing colors. Light, airy, hand-painted feel.",requiresUpload:!0},{id:"tshirt-design",labelKey:"ideas_prompt_tshirt_design",promptText:'Design a t-shirt graphic with bold lines and high contrast, ready to print. The text says: "your tagline here". Transparent background.',requiresUpload:!1},{id:"cute-character",labelKey:"ideas_prompt_cute_character",promptText:"Create a cute cartoon character — describe what you want here. Friendly, colorful, illustrated style on a clean background.",requiresUpload:!1}]},{id:"design",labelKey:"ideas_chip_design",prompts:[{id:"business-logo",labelKey:"ideas_prompt_business_logo",promptText:'Design a clean modern logo for "your business name". Bold, easy to read, works on signs and merch. Black and white, plus one accent color.',requiresUpload:!1},{id:"event-flyer",labelKey:"ideas_prompt_event_flyer",promptText:'Create an event flyer for "your event name". Include the date, time, and location at the bottom. Eye-catching design that fits the event\'s vibe.',requiresUpload:!1},{id:"sports-schedule",labelKey:"ideas_prompt_sports_schedule",promptText:'Make a sports schedule graphic for "your team name". Include the upcoming games and dates. Use the team\'s colors. Clean, shareable on social media.',requiresUpload:!1},{id:"social-media-ad",labelKey:"ideas_prompt_social_media_ad",promptText:'Design a social media advertisement for "your brand or product". Eye-catching, on-brand, with a clear call to action. Square format.',requiresUpload:!1}]},{id:"swap-outfit",labelKey:"ideas_chip_swap_outfit",prompts:[{id:"new-outfit",labelKey:"ideas_prompt_new_outfit",promptText:"Change the outfit on this person. Keep their face, body, pose, and hairstyle 100% identical — only the clothing changes. Describe the new outfit here.",requiresUpload:!0},{id:"swap-clothing",labelKey:"ideas_prompt_swap_clothing",promptText:"Take the outfit from the first image and put it on the person in the second image. Keep the second person's face, body, and pose exactly the same.",requiresUpload:!0},{id:"change-hairstyle",labelKey:"ideas_prompt_change_hairstyle",promptText:"Change only the hairstyle in this photo. Describe the new hairstyle here. Keep the face, expression, and everything else exactly the same.",requiresUpload:!0},{id:"outfit-color",labelKey:"ideas_prompt_outfit_color",promptText:"Change the color of the outfit in this photo. Describe the new color here. Keep the fit, fabric, and everything else identical.",requiresUpload:!0}]},{id:"visualize",labelKey:"ideas_chip_visualize",prompts:[{id:"restyle-room",labelKey:"ideas_prompt_restyle_room",promptText:"Redesign this room in a different style — modern, rustic, minimalist, or describe your own. Keep the room's basic shape and windows the same.",requiresUpload:!0},{id:"stage-room",labelKey:"ideas_prompt_stage_room",promptText:"Stage this empty room as if it's ready for sale. Add tasteful furniture, soft lighting, and a few decor pieces. Photorealistic, warm, inviting.",requiresUpload:!0},{id:"house-extension",labelKey:"ideas_prompt_house_extension",promptText:"Add an extension to this house — describe what you want (extra room, garage, second story). Match the existing architectural style exactly.",requiresUpload:!0},{id:"new-build",labelKey:"ideas_prompt_new_build",promptText:'Create a photorealistic exterior of a "describe the building" — natural lighting, real-estate photography style. Include the surroundings.',requiresUpload:!1}]}],"IMAGE_GENERATION_MODELS",0,[{id:"nano-banana",label:"Nano Banana",description:"Fast generation",provider:"google"},{id:"nano-banana-2",label:"Nano Banana 2",description:"Improved quality",provider:"google"},{id:"nano-banana-pro",label:"Nano Banana Pro",description:"Best quality",provider:"google"},{id:"seedream-4.5",label:"Seedream 4.5",description:"Photorealistic",provider:"bytedance"},{id:"flux-2-pro",label:"FLUX.2 Pro",description:"Professional grade",provider:"black-forest-labs"},{id:"flux-2-flex",label:"FLUX.2 Flex",description:"Flexible & creative",provider:"black-forest-labs"},{id:"flux-2-max",label:"FLUX.2 Max",description:"Maximum detail",provider:"black-forest-labs"}],"IMAGE_LANDING_COPY",0,{headline:"Generate stunning images with AI",subheadline:"Describe what you want to create and let AI do the rest.",prompt_placeholder:"Enter the description of the image you want to generate",prompt_text:"A professional photo of a minimalist workspace with a laptop, warm lighting, and a cup of coffee, shallow depth of field",button:"Generate image",prompt_version:"image-landing-v1",styles:[{id:"none",label:"None"},{id:"realistic",label:"Realistic",image:p},{id:"cartoon",label:"Cartoon",image:u},{id:"3d",label:"3D Render",image:s},{id:"anime",label:"Anime",image:d},{id:"digital-art",label:"Digital Art",image:c},{id:"abstract",label:"Abstract",image:o}],aspectRatios:[{id:"1:1",label:"1:1 (Square)"},{id:"4:3",label:"4:3 (Standard)"},{id:"3:4",label:"3:4 (Portrait)"},{id:"16:9",label:"16:9 (Widescreen)"},{id:"9:16",label:"9:16 (Mobile)"},{id:"21:9",label:"21:9 (Ultrawide)"}]},"IMAGE_VARIATIONS",0,[{id:1,translationKey:"variations_1"},{id:2,translationKey:"variations_2"},{id:4,translationKey:"variations_4"}]],65228)},882515,e=>{"use strict";var t=e.i(500932),r=e.i(605833);e.i(916134);var a=e.i(711752);e.s(["useNewFeatureButtonsBelowInput",0,()=>{let e,i,l=(0,t.c)(7),n=(0,r.useExperimentValue)(a.ExperimentKey.NEW_FEATURE_BUTTONS_BELOW_INPUT,"OFF");l[0]===Symbol.for("react.memo_cache_sentinel")?(e=["A","B","C"],l[0]=e):e=l[0];let s=e.includes(n),o="B"===n,d="C"===n,u=o||d;return l[1]!==s||l[2]!==o||l[3]!==d||l[4]!==u||l[5]!==n?(i={isInExperiment:s,variant:n,isTreatment:u,isVariantB:o,isVariantC:d},l[1]=s,l[2]=o,l[3]=d,l[4]=u,l[5]=n,l[6]=i):i=l[6],i}])},367240,e=>{"use strict";let t=(0,e.i(475254).default)("rotate-ccw",[["path",{d:"M3 12a9 9 0 1 0 9-9 9.75 9.75 0 0 0-6.74 2.74L3 8",key:"1357e3"}],["path",{d:"M3 3v5h5",key:"1xhq8a"}